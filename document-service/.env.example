DEBUG=false
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5433/documents
STORAGE_DIR=./storage
MAX_UPLOAD_SIZE_BYTES=20971520

# For local (non-Docker) runs against a Docker-Compose-managed Ollama, which
# maps to localhost:11434 the same way Postgres maps to localhost:5433. Inside
# Docker Compose, document-service overrides this to http://ollama:11434.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
OLLAMA_TIMEOUT_SECONDS=120
